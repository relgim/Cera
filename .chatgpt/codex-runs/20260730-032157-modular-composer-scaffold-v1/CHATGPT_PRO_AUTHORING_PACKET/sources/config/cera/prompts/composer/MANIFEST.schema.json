{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cera.prompt_module_registry_manifest.v1",
  "title": "Inactive CERA modular Composer prompt registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "modules",
    "runtime_external_path_dependencies",
    "creative_prompt_limit_enforced",
    "fixed_example_count_enforced"
  ],
  "properties": {
    "schema_version": {"const": "cera.prompt_module_registry_manifest.v1"},
    "registry_version": {"type": "string"},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id", "version", "layer", "relative_path", "sha256",
          "deterministic_order", "allowed_scene_depth_modes",
          "allowed_adult_rendering_modes", "allowed_interaction_topologies",
          "allowed_scene_functions", "dependencies", "conflicts",
          "noncanonical", "noncopyable", "source_provenance", "enabled_state"
        ],
        "properties": {
          "module_id": {"type": "string"},
          "version": {"type": "string"},
          "layer": {
            "enum": [
              "core_authority", "structured_output", "depth",
              "adult_rendering", "interaction_topology", "scene_function"
            ]
          },
          "relative_path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "deterministic_order": {"type": "integer", "minimum": 0},
          "allowed_scene_depth_modes": {
            "type": "array", "items": {"enum": ["off", "auto", "long", "epic"]}
          },
          "allowed_adult_rendering_modes": {
            "type": "array", "items": {"enum": ["off", "on", "ex"]}
          },
          "allowed_interaction_topologies": {
            "type": "array",
            "items": {"enum": ["single_npc_floor", "multi_npc_shared_floor", "npc_to_npc_exchange"]}
          },
          "allowed_scene_functions": {
            "type": "array",
            "items": {"enum": ["ordinary_social", "emotional_vulnerability", "confrontation_boundary", "urgent_physical_action", "aftermath_recovery"]}
          },
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "conflicts": {"type": "array", "items": {"type": "string"}},
          "noncanonical": {"type": "boolean"},
          "noncopyable": {"type": "boolean"},
          "source_provenance": {"type": "string"},
          "enabled_state": {"enum": ["disabled", "fixture_only", "shadow_only"]}
        }
      }
    },
    "runtime_external_path_dependencies": {"type": "array", "maxItems": 0},
    "creative_prompt_limit_enforced": {"const": false},
    "fixed_example_count_enforced": {"const": false}
  }
}


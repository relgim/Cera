      },
      "acceptance": null,
      "actions": {
        "accept_enabled": false,
        "regenerate_enabled": false,
        "decline_enabled": false,
        "replan_enabled": false,
        "auditable_override_enabled": false,
        "auditable_override_action": null,
        "repair_recording_enabled": false
      },
      "request_controls": {
        "schema_version": "cera.pi_scene.request_controls.v3",
        "session_id": "ordinary-review-fixture",
        "scene_depth": "auto",
        "regeneration_key": null,
        "character_autonomy": "both",
        "prompt_handling": "adjustment",
        "reasoning_effort": "medium",
        "scene_change": false,
        "adult_craft_mode": "off",
        "review_mode": "automatic"
      },
      "creator_guidance": null,
      "provider_attempts": [
        {
          "attempt_number": 1,
          "candidate_id": "candidate-bbbbbbbbbbbbbbbbbbbbbbbbbbbb",
          "disposition": "checks_pending",
          "provider_operations": {
            "planner": 1,
            "writer": 1,
            "validator": 0,
            "reader": 0
          }
        }
      ],
      "provider_operations": {
        "planner": 1,
        "writer": 1,
        "validator": 0,
        "reader": 0,
        "recorder": 0
      },
      "terminal_decision": null
    }
  ],

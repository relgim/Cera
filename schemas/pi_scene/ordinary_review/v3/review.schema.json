{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cera.local/pi-scene/ordinary-review/v3/review.schema.json",
  "title": "OrdinaryReviewV3",
  "description": "Privacy-safe public read model for one exact ordinary Writer candidate and its independent Luna, Reader, and Python checks.",
  "x-cera-schema-version": "cera.pi_scene.review.v3",
  "x-cera-python-name": "OrdinaryReviewV3",
  "x-cera-javascript-name": "OrdinaryReviewV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "state",
    "review_mode",
    "route",
    "story_text",
    "candidate_id",
    "candidate_sha256",
    "primary_authority_kind",
    "primary_authority_sha256",
    "warnings",
    "recording_status",
    "gate_status",
    "checks",
    "acceptance",
    "actions",
    "request_controls",
    "creator_guidance",
    "provider_attempts",
    "provider_operations",
    "terminal_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "cera.pi_scene.review.v3"
    },
    "review_id": {
      "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/review_id"
    },
    "state": {
      "enum": [
        "checks_pending",
        "review_ready",
        "accepted",
        "declined",
        "regenerated",
        "replanned"
      ]
    },
    "review_mode": {
      "enum": [
        "automatic",
        "manual"
      ]
    },
    "route": {
      "const": "ordinary",
      "description": "Adult protected prose is never valid in this public contract family."
    },
    "story_text": {
      "type": "string",
      "minLength": 1,
      "description": "The exact frozen ordinary Writer prose."
    },
    "candidate_id": {
      "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/candidate_id"
    },
    "candidate_sha256": {
      "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/sha256"
    },
    "primary_authority_kind": {
      "const": "codex_cognition_plan",
      "description": "Review v2 is bound only to the executable cognition-plan lifecycle; legacy sequence reviews remain review v1."
    },
    "primary_authority_sha256": {
      "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/sha256"
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/warning"
      }
    },
    "recording_status": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "projection_pending",
            "pending_repair",
            "complete"
          ]
        }
      ]
    },
    "gate_status": {
      "enum": [
        "pending",
        "pass",
        "reject",
        "blocked"
      ]
    },
    "checks": {
      "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/review_checks.schema.json"
    },
    "acceptance": {
      "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/acceptance"
    },
    "actions": {
      "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/actions"
    },
    "request_controls": {
      "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/request_controls_v3",
      "description": "Exact non-null LeanScene request-controls V3 projection for this new lifecycle. V1, V2, and null remain legacy review v1 only."
    },
    "creator_guidance": {
      "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/creator_guidance_projection"
    },
    "provider_attempts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/provider_attempt"
      }
    },
    "provider_operations": {
      "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/provider_operations"
    },
    "terminal_decision": {
      "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/terminal_decision_link"
    }
  },
  "x-cera-review-invariants": [
    {
      "op": "ordinary_review_gate_matches_checks"
    },
    {
      "op": "ordinary_review_state_actions_acceptance"
    },
    {
      "op": "review_terminal_link_matches_review_id"
    },
    {
      "op": "ordinary_provider_accounting_matches_attempts"
    },
    {
      "op": "review_mode_matches_request_controls"
    },
    {
      "op": "forbidden_public_keys"
    }
  ],
  "examples": [
    {
      "schema_version": "cera.pi_scene.review.v3",
      "review_id": "review-aaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "state": "checks_pending",
      "review_mode": "automatic",
      "route": "ordinary",
      "story_text": "Hana pauses beside the doorway, leaving the invitation open.",

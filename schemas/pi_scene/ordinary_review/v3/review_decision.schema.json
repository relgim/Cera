{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cera.local/pi-scene/ordinary-review/v3/review_decision.schema.json",
  "title": "OrdinaryReviewDecisionV3",
  "description": "Terminal ordinary creator or automatic decision. A non-null successor is validated only by the injected exact ordinary-completion validator; this contract never treats an open object as a successor.",
  "x-cera-schema-version": "cera.pi_scene.review_decision.v3",
  "x-cera-python-name": "OrdinaryReviewDecisionV3",
  "x-cera-javascript-name": "OrdinaryReviewDecisionV3",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "creator_action",
        "story_state_committed",
        "retry_mode",
        "review",
        "successor",
        "operational_warnings",
        "accepted_receipt_sha256",
        "accepted_turn_id"
      ],
      "properties": {
        "schema_version": {
          "const": "cera.pi_scene.review_decision.v3"
        },
        "status": {
          "const": "story_committed"
        },
        "creator_action": {
          "enum": [
            "automatic_accept",
            "accept",
            "accept_provisional",
            "standing_policy_accept_provisional",
            "repair_recording"
          ]
        },
        "story_state_committed": {
          "const": true
        },
        "retry_mode": {
          "const": "not_applicable"
        },
        "review": {
          "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/review.schema.json"
        },
        "successor": {
          "type": "null"
        },
        "operational_warnings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\\u0000]+$"
          }
        },
        "accepted_receipt_sha256": {
          "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/sha256"
        },
        "accepted_turn_id": {
          "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/common.schema.json#/$defs/bounded_identifier"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "creator_action",
        "story_state_committed",
        "retry_mode",
        "review",
        "successor",
        "operational_warnings"
      ],
      "properties": {
        "schema_version": {
          "const": "cera.pi_scene.review_decision.v3"
        },
        "status": {
          "const": "review_transitioned"
        },
        "creator_action": {
          "enum": [
            "decline",
            "regenerate",
            "replan"
          ]
        },
        "story_state_committed": {
          "const": false
        },
        "retry_mode": {
          "const": "not_applicable"
        },
        "review": {
          "$ref": "https://schemas.cera.local/pi-scene/ordinary-review/v3/review.schema.json"
        },
        "successor": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "x-cera-external-validator": "ordinary_successor"
            }
          ]
        },
        "operational_warnings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\\u0000]+$"
          }
        }
      }
    }
  ],
  "x-cera-external-validators": {
    "ordinary_successor": {
      "field": "successor",
      "required_when_non_null": true,
      "description": "Existing exact ordinary chat-completion projector/normalizer."
    }
  },
  "x-cera-review-invariants": [
    {
      "op": "ordinary_review_decision_consistency"
    },
    {
      "op": "detached_terminal_decision_sha256"
    },
    {
      "op": "forbidden_public_keys"
    }
  ],
  "examples": [
    {
      "schema_version": "cera.pi_scene.review_decision.v3",
      "status": "story_committed",
      "creator_action": "automatic_accept",
      "story_state_committed": true,
      "retry_mode": "not_applicable",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cera.local/provider-stage-retry/v1/status.schema.json",
  "title": "ProviderStageRetryStatusV1",
  "description": "Privacy-safe shared status for exactly one provider-stage occurrence. Semantic Regenerate and Replan are intentionally absent because they have separate identities and counters.",
  "x-cera-schema-version": "cera.provider_stage_retry_status.v1",
  "x-cera-python-name": "ProviderStageRetryStatusV1",
  "x-cera-javascript-name": "ProviderStageRetryStatusV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chain_id",
    "provider",
    "model_family",
    "stage",
    "state",
    "maximum_attempts",
    "stage_attempts_total",
    "retry_actions_accepted",
    "provider_operations_observed_total",
    "provider_operations_conservative_total",
    "story_state_committed",
    "branch_preserved_at_last_accepted_head",
    "failure_category",
    "available_actions",
    "technical_details"
  ],
  "properties": {
    "schema_version": {
      "const": "cera.provider_stage_retry_status.v1",
      "description": "Immutable shared status schema version."
    },
    "chain_id": {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/chain_id"
    },
    "provider": {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/provider"
    },
    "model_family": {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/model_family"
    },
    "stage": {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/stage"
    },
    "state": {
      "type": "string",
      "enum": [
        "eligible",
        "in_progress",
        "succeeded",
        "blocked_ambiguous",
        "attempts_exhausted",
        "recording_repair_required",
        "recovery_required"
      ],
      "description": "User-visible state. blocked_ambiguous, attempts_exhausted, and recovery_required are distinct."
    },
    "maximum_attempts": {
      "const": 3,
      "description": "Backend-authoritative ceiling: one initial attempt plus two manual Retry actions."
    },
    "stage_attempts_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Accepted executions for this exact branch, generation, stage, and stage occurrence."
    },
    "retry_actions_accepted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "description": "Backend-accepted manual provider Retry actions for this occurrence only."
    },
    "provider_operations_observed_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Ledger-proven provider operations."
    },
    "provider_operations_conservative_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Observed operations plus unresolved possible operations."
    },
    "story_state_committed": {
      "type": "boolean",
      "description": "True only for Recorder, whose accepted story precedes recording."
    },
    "branch_preserved_at_last_accepted_head": {
      "const": true,
      "description": "The Retry chain never rolls back or replays the whole request."
    },
    "failure_category": {
      "anyOf": [
        {
          "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/retryable_failure_category"
        },
        {
          "const": "dispatch_ambiguous"
        },
        {
          "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/non_retryable_failure_category"
        },
        {
          "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/block_reason"
        },
        {
          "type": "null"
        }
      ],
      "description": "Safe closed failure category, or null when no failed attempt controls the state."
    },
    "available_actions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "provider_retry",
          "resume_prepared",
          "check_status",
          "repair_recording"
        ]
      },
      "description": "Concise UI actions. Semantic Regenerate and Replan use different DTO families."
    },
    "technical_details": {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/technical_details",
      "description": "Hashes and detailed identity for the collapsed Technical details section."
    }
  },
  "allOf": [
    {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/owner_binding"
    },
    {
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "eligible"
            },
            "failure_category": {
              "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/retryable_failure_category"
            },
            "available_actions": {
              "const": [
                "provider_retry"
              ]
            }
          },
          "anyOf": [
            {
              "properties": {
                "stage_attempts_total": {
                  "const": 1
                },
                "retry_actions_accepted": {
                  "const": 0
                }
              }
            },
            {
              "properties": {
                "stage_attempts_total": {
                  "const": 2
                },
                "retry_actions_accepted": {
                  "const": 1
                }
              }
            }
          ]
        },
        {
          "properties": {
            "state": {
              "const": "in_progress"
            },
            "stage_attempts_total": {
              "minimum": 1
            },
            "failure_category": {
              "type": "null"
            },
            "available_actions": {
              "oneOf": [
                {
                  "const": []
                },
                {
                  "const": [
                    "resume_prepared"
                  ]
                }
              ]
            }
          },
          "$comment": "Counter relation is enforced by x-cera-invariants below."
        },
        {
          "properties": {
            "state": {
              "const": "succeeded"
            },
            "stage_attempts_total": {
              "minimum": 1
            },
            "provider_operations_observed_total": {
              "minimum": 1
            },
            "failure_category": {
              "type": "null"
            },
            "available_actions": {
              "const": []
            }
          },
          "$comment": "Counter relation is enforced by x-cera-invariants below."
        },
        {
          "properties": {
            "state": {
              "const": "blocked_ambiguous"
            },
            "stage_attempts_total": {
              "minimum": 1
            },
            "provider_operations_conservative_total": {
              "minimum": 1
            },
            "failure_category": {
              "const": "dispatch_ambiguous"
            },
            "available_actions": {
              "const": [
                "check_status"
              ]
            }
          },
          "$comment": "Counter relation is enforced by x-cera-invariants below."
        },
        {
          "properties": {
            "state": {
              "const": "attempts_exhausted"
            },
            "stage": {
              "enum": [
                "planner",
                "semantic_validator",
                "writer",
                "adult_scene",
                "adult_filter"
              ]
            },
            "stage_attempts_total": {
              "const": 3
            },
            "retry_actions_accepted": {
              "const": 2
            },
            "failure_category": {
              "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/retryable_failure_category"
            },
            "available_actions": {
              "const": []
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "recording_repair_required"
            },
            "stage": {
              "const": "recorder"
            },
            "stage_attempts_total": {
              "const": 3
            },
            "retry_actions_accepted": {
              "const": 2
            },
            "failure_category": {
              "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/retryable_failure_category"
            },
            "available_actions": {
              "oneOf": [
                {
                  "const": []
                },
                {
                  "const": [
                    "repair_recording"
                  ]
                }
              ]
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "recovery_required"
            },
            "stage_attempts_total": {
              "minimum": 0
            },
            "failure_category": {
              "anyOf": [
                {
                  "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/non_retryable_failure_category"
                },
                {
                  "enum": [
                    "input_changed",
                    "authority_changed",
                    "ledger_prefix_changed",
                    "owner_retirement_unproven",
                    "result_checkpoint_conflict"
                  ]
                }
              ]
            },
            "available_actions": {
              "const": []
            }
          },
          "$comment": "A known non-Retry terminal or non-dispatch custody conflict preserves accepted state. Recovery is a separate operator workflow, not a generic Retry-chain action."
        }
      ]
    }
  ],
  "x-cera-invariants": [
    {
      "op": "field_gte_field",
      "left": "provider_operations_conservative_total",
      "right": "provider_operations_observed_total",
      "message": "conservative provider accounting undercounts observed operations"
    },
    {
      "op": "allowed_field_pairs",
      "fields": [
        "stage_attempts_total",
        "retry_actions_accepted"
      ],
      "allowed": [
        [
          0,
          0
        ],
        [
          1,
          0
        ],
        [
          2,
          1
        ],
        [
          3,
          2
        ]
      ],
      "message": "stage attempts and accepted Retry actions do not identify one occurrence chain"
    }
  ],

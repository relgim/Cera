{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cera.local/provider-stage-retry/v1/exhausted.schema.json",
  "title": "ProviderStageRetryExhaustedV1",
  "description": "Hash-only terminal evidence after three closed, confirmed provider-stage failures. Recorder evidence is projected to recording_repair_required by the shared status contract.",
  "x-cera-schema-version": "cera.provider_stage_retry_exhausted.v1",
  "x-cera-python-name": "ProviderStageRetryExhaustedV1",
  "x-cera-javascript-name": "ProviderStageRetryExhaustedV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "severity",
    "provider",
    "model_family",
    "stage",
    "maximum_attempts",
    "attempts_total",
    "retries_consumed",
    "story_state_committed",
    "failed_stage_effect_committed",
    "provider_operations_observed_total",
    "provider_operations_conservative_total",
    "final_failure_class",
    "request_sha256",
    "stage_input_sha256",
    "attempt_chain_sha256",
    "terminal_evidence_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "cera.provider_stage_retry_exhausted.v1",
      "description": "Immutable exhaustion evidence version."
    },
    "severity": {
      "const": "critical",
      "description": "Stable terminal severity."
    },
    "provider": {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/provider"
    },
    "model_family": {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/model_family"
    },
    "stage": {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/stage"
    },
    "maximum_attempts": {
      "const": 3,
      "description": "Backend-authoritative attempt ceiling."
    },
    "attempts_total": {
      "const": 3,
      "description": "Three accepted stage executions in this occurrence chain."
    },
    "retries_consumed": {
      "const": 2,
      "description": "Compatibility name for the two backend-accepted Retry actions."
    },
    "story_state_committed": {
      "type": "boolean",
      "description": "True only for Recorder because story acceptance precedes recording."
    },
    "failed_stage_effect_committed": {
      "const": false,
      "description": "The failed stage never publishes or binds its effect."
    },
    "provider_operations_observed_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Ledger-proven provider operations."
    },
    "provider_operations_conservative_total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Observed operations plus unresolved possible operations."
    },
    "final_failure_class": {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/retryable_failure_category",
      "description": "The third closed retryable failure; unresolved ambiguity is forbidden here."
    },
    "request_sha256": {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/sha256"
    },
    "stage_input_sha256": {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/sha256"
    },
    "attempt_chain_sha256": {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/sha256"
    },
    "terminal_evidence_sha256": {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "$ref": "https://schemas.cera.local/provider-stage-retry/v1/common.schema.json#/$defs/owner_binding"
    }
  ],
  "x-cera-invariants": [
    {
      "op": "field_gte_field",
      "left": "provider_operations_conservative_total",
      "right": "provider_operations_observed_total",
      "message": "conservative provider accounting undercounts observed operations"
    }
  ],
  "examples": [
    {
      "schema_version": "cera.provider_stage_retry_exhausted.v1",
      "severity": "critical",
      "provider": "codex",
      "model_family": "sol",
      "stage": "planner",
      "maximum_attempts": 3,
      "attempts_total": 3,
      "retries_consumed": 2,
      "story_state_committed": false,
      "failed_stage_effect_committed": false,
      "provider_operations_observed_total": 3,
      "provider_operations_conservative_total": 3,
      "final_failure_class": "provider_unavailable",
      "request_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "stage_input_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "attempt_chain_sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "terminal_evidence_sha256": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
    },
    {
      "schema_version": "cera.provider_stage_retry_exhausted.v1",
      "severity": "critical",
      "provider": "deepseek",
      "model_family": "deepseek_v4",
      "stage": "recorder",
      "maximum_attempts": 3,
      "attempts_total": 3,
      "retries_consumed": 2,
      "story_state_committed": true,
      "failed_stage_effect_committed": false,
      "provider_operations_observed_total": 2,
      "provider_operations_conservative_total": 2,
      "final_failure_class": "provider_completion_incomplete",
      "request_sha256": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      "stage_input_sha256": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
      "attempt_chain_sha256": "1111111111111111111111111111111111111111111111111111111111111111",
      "terminal_evidence_sha256": "2222222222222222222222222222222222222222222222222222222222222222"
    }
  ],
  "x-cera-negative-fixtures": [
    {
      "name": "only_two_attempts",
      "base_example": 0,
      "patch": [
        {
          "op": "replace",
          "path": "/attempts_total",
          "value": 2
        }
      ]
    },
    {
      "name": "ambiguity_is_not_exhaustion",
      "base_example": 0,
      "patch": [
        {
          "op": "replace",
          "path": "/final_failure_class",
          "value": "dispatch_ambiguous"
        }
      ]
    },
    {
      "name": "output_limit_is_not_retryable",
      "base_example": 0,
      "patch": [
        {
          "op": "replace",
          "path": "/final_failure_class",
          "value": "configured_output_limit"
        }
      ]
    },
    {
      "name": "recorder_story_rolled_back",
      "base_example": 1,
      "patch": [
        {
          "op": "replace",
          "path": "/story_state_committed",
          "value": false
        }
      ]
    },
    {
      "name": "failed_effect_claimed_committed",
      "base_example": 0,
      "patch": [
        {
          "op": "replace",
          "path": "/failed_stage_effect_committed",
          "value": true
        }
      ]
    },
    {
      "name": "conservative_accounting_undercounts",
      "base_example": 0,
      "patch": [
        {
          "op": "replace",
          "path": "/provider_operations_conservative_total",
          "value": 2
        }
      ]
    }
  ]
}
